<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="Plugin Project" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">

    <description>Custom set of rules to check for Coding Standards in WordPress project</description>

    <file>.</file>
    <!-- Exclude WP Core folders and files from being checked. -->

    <arg name="extensions" value="php"/>

    <rule ref="WordPress">
        <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
        <exclude name="WordPress.WP.I18n.TextDomainMismatch"/>
        <exclude name="PSR2.Methods.MethodDeclaration.Underscore"/>
        <exclude name="Generic.Files.OneObjectStructurePerFile.MultipleFound"/>
        <exclude name="Squiz.PHP.CommentedOutCode.Found"/>
        <exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
        <exclude-pattern>inc/plugins</exclude-pattern>
    </rule>

    <ini name="memory_limit" value="512M"/>

</ruleset>
